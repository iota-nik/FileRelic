@startuml FileRelicProposedArchitecture
title FileRelic — Proposed Class Diagram (reproduction of references/diagrams/class.jpeg)

top to bottom direction
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam linetype ortho
skinparam shadowing false

class UIManager {
  +selectDrive(path: String)
  +initiateScan()
  +displayProgress()
  +previewRecoveredFiles()
}

abstract class RecoveryEngine {
  +detectFileSystem()
  +extractMetadata()
  +walkFreeBlocks()
}

class XFSParser {
  +parseBtrees()
}

class BtrfsParser {
  +parseCoWMetadata()
}

class VerificationLayer {
  +generateSHA256(fileData: Byte[])
  +compareWithSourceChecksum(hash: String): Boolean
}

class StorageAndReportingLayer {
  +logCaseMetadata()
  +generatePDFReport()
  +generateHTMLReport()
}

class FileRecord {
  -fileName: String
  -filePath: String
  -originalChecksum: String
  -recoveredHash: String
  -isProvablyIntact: Boolean
}

UIManager --> RecoveryEngine : orchestrates
XFSParser --|> RecoveryEngine
BtrfsParser --|> RecoveryEngine
RecoveryEngine -right-> VerificationLayer : sends extracted files
VerificationLayer -down-> StorageAndReportingLayer : sends verified records
StorageAndReportingLayer -down-> FileRecord : stores/exports
VerificationLayer "1" -down-> "*" FileRecord : validates

@enduml
